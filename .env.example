# ─── App ───────────────────────────────────────────────────────────────
PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Set to true to force simulated payments even if Paystack keys exist
# DEMO_MODE=true

# Demo dashboard at /demo (default: relief-demo-2026)
DEMO_DASHBOARD_KEY=relief-demo-2026

# Staff portal subdomain (same app — middleware routes to /en/staff)
STAFF_PORTAL_HOST=reservation.reliefhotelsandsuites.com.ng

# ─── Supabase (production — ADR-001) ─────────────────────────────────
# Without these, bookings use local data/*.json (demo/local only)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# ─── Paystack (https://dashboard.paystack.com) ───────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# ─── Email via Resend (https://resend.com) ───────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Relief Hotels <onboarding@resend.dev>
RESERVATION_EMAIL=reservations@reliefhotelsandsuites.com.ng

# ─── Manager alerts (launch) ─────────────────────────────────────────
# SMS/WhatsApp deferred — see ADR-003. Ops use email + /demo dashboard.
NOTIFY_CHANNEL=console