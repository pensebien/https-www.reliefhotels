# ─── App ───────────────────────────────────────────────────────────────
PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Set to true to force simulated payments even if Paystack keys exist
# DEMO_MODE=true

# Demo dashboard at /demo (default: relief-demo-2026)
DEMO_DASHBOARD_KEY=relief-demo-2026

# Staff portal subdomain (same app — middleware routes to /en/staff)
STAFF_PORTAL_HOST=reservation.reliefhotelsandsuites.com

# ─── Supabase (production — ADR-001) ─────────────────────────────────
# Without these, bookings use local data/*.json (demo/local only)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# ─── Paystack (https://paystack.com/docs/api/authentication/) ───────
# Authorization: Bearer SECRET_KEY on all server calls to api.paystack.co
# Test: pk_test_ / sk_test_   Live: pk_live_ / sk_live_
# Dashboard callback (guest return): {NEXT_PUBLIC_APP_URL}/payment/callback
# Example prod: https://www.reliefhotelsandsuites.com/payment/callback
# Webhook: not implemented yet — leave empty in Paystack dashboard
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
# Paystack Terminal (front-desk cashier — ADR-005)
PAYSTACK_TERMINAL_ID=
CASHIER_ENABLED=true

# ─── Email via Resend (https://resend.com) ───────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Relief Hotels <onboarding@resend.dev>
RESERVATION_EMAIL=reservations@reliefhotelsandsuites.com

# ─── Manager alerts (launch) ─────────────────────────────────────────
# SMS/WhatsApp deferred — see ADR-003. Ops use email + /demo dashboard.
NOTIFY_CHANNEL=console

# ─── Moniepoint (front-desk POS & transfers) ─────────────────────────
# API docs: https://teamapt.atlassian.net/wiki/spaces/EI/
MONIEPOINT_CLIENT_ID=
MONIEPOINT_CLIENT_SECRET=
MONIEPOINT_TERMINAL_SERIAL=
MONIEPOINT_BASE_URL=https://channel.moniepoint.com
MONIEPOINT_TRANSFER_BANK_NAME=Moniepoint
MONIEPOINT_TRANSFER_ACCOUNT_NAME=Relief Hotels & Suites
MONIEPOINT_TRANSFER_ACCOUNT_NUMBER=

# ─── RAYZA Connect (optional PMS relay) ──────────────────────────────
# Partner desktop HMS relay — https://cloud-relay-nu.vercel.app
RAYZA_CONNECT_ENABLED=false
RAYZA_BASE_URL=https://cloud-relay-nu.vercel.app
RAYZA_API_KEY=