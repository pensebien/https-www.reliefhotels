%% Cashier / front desk: walk-ins, taking payments, check-out.
%% Role: cashier (manager can do all of this too).
flowchart TD
    classDef staff fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef system fill:#f3f4f6,stroke:#6b7280,color:#111827
    classDef ext fill:#ede9fe,stroke:#7c3aed,color:#3b0764
    classDef warn fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef good fill:#dcfce7,stroke:#16a34a,color:#14532d

    A["Sign in: role cashier"]:::staff --> B{"Guest has an<br/>online booking?"}:::staff
    B -->|"no — walk-in"| C["Create reservation dialog"]:::staff
    C --> C1{"Same engine as online:<br/>room still free?"}:::system
    C1 -->|"no"| C2["Refused — room already taken<br/>cannot be overridden"]:::warn
    C1 -->|"yes"| C3{"Stay rules pass?<br/>guest limit, min stay, closed dates"}:::system
    C3 -->|"no"| C4["Warning shown — tick<br/>Override stay rules to proceed<br/>noted on the booking"]:::warn
    C4 --> D
    C3 -->|"yes"| D
    B -->|"yes"| D["/staff/cashier queue:<br/>pick the reservation"]:::staff

    D --> E["Suggested amount = deposit locked<br/>at booking: seasons, discounts,<br/>promo, extras, rooms"]:::staff
    E --> F{"Payment method"}:::staff
    F -->|"Cash"| G["Record cash"]:::staff
    F -->|"Card"| H["Push to POS terminal<br/>Moniepoint or Paystack"]:::ext
    F -->|"Transfer"| I["Guest pays Moniepoint account"]:::ext
    H --> J{"Terminal / webhook<br/>confirms?"}:::system
    I --> J
    J -->|"slow or no webhook"| J1["Check status, then<br/>manual confirm"]:::staff
    J -->|"yes"| K
    J1 --> K
    G --> K["Payment success → reservation confirmed"]:::good
    K --> L["Receipt email, manager alert, RAYZA sync"]:::system

    K --> M["Guest stays — F&B charges<br/>added to folio, see 04-fnb-flow"]:::system
    M --> N["Settle folio: minibar, restaurant, laundry<br/>with VAT from tax settings"]:::staff
    N --> O["Calendar → Check out<br/>only for confirmed bookings"]:::staff
    O --> P["Status checked_out"]:::system
    P --> Q["Room auto-blocked for housekeeping<br/>today → tomorrow, see 05-housekeeping"]:::system

    D --> R["Cancel booking if needed<br/>status cancelled, room freed"]:::staff
