%% Guest: search → RAYZA price/availability → reserve → pay → RAYZA → emails → manage / cancel.
%% RAYZA (the hotel software) owns rates, rooms, front desk, F&B and OTA channels.
flowchart TD
    classDef guest fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef system fill:#f3f4f6,stroke:#6b7280,color:#111827
    classDef rayza fill:#ede9fe,stroke:#7c3aed,color:#3b0764
    classDef bad fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef good fill:#dcfce7,stroke:#16a34a,color:#14532d

    A["Guest picks dates, guests, rooms<br/>/rooms"]:::guest --> B["GET /api/rooms/availability"]:::system
    B --> R1["RAYZA GET /v1/rooms<br/>free rooms, tax-inclusive price,<br/>occupancy, stay rules"]:::rayza
    R1 --> C{"RAYZA reachable<br/>and room type linked?"}:::system
    C -->|"no"| C0["Call / WhatsApp to book<br/>nothing sold online"]:::bad
    C -->|"yes"| C3{"Free after unpaid<br/>website holds?"}:::system
    C3 -->|"no"| C1["Room not listed"]:::bad
    C3 -->|"RAYZA rule: min stay,<br/>capacity, closed"| C2["Card shows reason"]:::bad
    C3 -->|"yes"| D["Card shows RAYZA price × nights"]:::good
    D --> E["/book: live quote<br/>POST /api/booking/quote"]:::guest
    E --> G["Guest enters details,<br/>accepts terms"]:::guest
    G --> H["POST /api/reservations"]:::system
    H --> I["Server re-asks RAYZA (fresh);<br/>ignores client nights and prices"]:::rayza
    I --> J{"reserve_room_capped:<br/>unpaid holds + this booking<br/>≤ RAYZA free?"}:::system
    J -->|"no"| J1["409: choose other dates"]:::bad
    J -->|"yes"| K["Reservation saved: pending<br/>price + deposit locked<br/>room held 60 min"]:::good
    K --> L["Emails: guest confirmation<br/>with Manage link, hotel inbox"]:::system
    K --> M["POST /api/paystack/initialize<br/>(card or Pay with Transfer)"]:::system
    M --> N{"Hold still valid?"}:::system
    N -->|"expired"| N1["409: search again"]:::bad
    N -->|"yes"| P["Paystack checkout"]:::guest
    P --> Q["Webhook charge.success<br/>or callback verify"]:::system
    Q --> S["Reservation confirmed"]:::good
    S --> T1["RAYZA POST /v1/bookings<br/>(idempotent reference)"]:::rayza
    T1 -->|"accepted"| T2["Receipt email,<br/>manager SMS/WhatsApp"]:::good
    T1 -->|"RAYZA refused<br/>(e.g. ROOM_UNAVAILABLE)"| T3["Guest: we'll contact you<br/>Front desk: ACTION NEEDED email + SMS<br/>flagged in staff bookings view"]:::bad
    T1 -->|"unreachable"| T4["Retried every 15 min<br/>by /api/cron/rayza"]:::system

    S --> V["Guest opens Manage link<br/>/booking/manage?id=…&t=…"]:::guest
    V --> W["Pay balance<br/>POST /api/booking/manage/pay"]:::guest
    V --> Y["Cancel (if allowed)<br/>POST /api/booking/manage/cancel"]:::guest
    Y --> Z["Cancelled; room released in RAYZA<br/>refund handled by the hotel"]:::rayza

    X["Guest paid by bank transfer<br/>directly to the hotel"]:::guest --> X1["Staff: /staff → Record transfer received"]:::system
    X1 --> S
