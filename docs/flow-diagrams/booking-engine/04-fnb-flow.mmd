%% F&B staff: charge in-house guests for food, drinks, minibar, laundry.
%% Roles: restaurant_owner (also cashier, manager).
flowchart TD
    classDef staff fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef system fill:#f3f4f6,stroke:#6b7280,color:#111827
    classDef warn fill:#fef3c7,stroke:#d97706,color:#78350f

    A["Sign in: role restaurant_owner"]:::staff --> B["/staff/fnb"]:::staff
    B --> C["Pick the in-house guest's reservation<br/>cancelled bookings are hidden"]:::staff
    C --> D["Browse catalog, choose item + quantity"]:::staff
    D --> E["POST /api/staff/folio/charges"]:::system
    E --> F["Charge saved: status open<br/>linked to the reservation"]:::system
    F --> G{"Next step"}:::staff
    G -->|"posted to room bill"| H["status posted"]:::system
    G -->|"guest paid at the outlet"| I["status paid"]:::system
    G -->|"mistake"| J["status void"]:::system
    H --> K["Cashier settles folio at check-out<br/>see 03-cashier-flow"]:::staff
    B --> L["VAT shown per tax settings<br/>/staff/settings/tax — restaurant_owner can edit"]:::system
    F -.-> M["Note: folio charges are separate from<br/>the room total on the guest's manage page"]:::warn
