%% Staff on the website: watch online bookings, reconcile payments, keep RAYZA in sync.
%% Rates, rooms, front desk, F&B, housekeeping and OTA channels are managed in RAYZA.
flowchart TD
    classDef staff fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef system fill:#f3f4f6,stroke:#6b7280,color:#111827
    classDef rayza fill:#ede9fe,stroke:#7c3aed,color:#3b0764
    classDef warn fill:#fef3c7,stroke:#d97706,color:#78350f

    A["Sign in to staff portal"]:::staff --> B["/staff — Online bookings"]:::staff
    A --> R["/staff/rayza — manager only"]:::staff

    subgraph Setup["One-time setup"]
        R --> R1["Link each website room type<br/>to its RAYZA room type"]:::staff
        R1 --> R2["Unlinked room types aren't sold online"]:::system
        R --> R3["Sync now: push/cancel everything,<br/>retrying failed bookings"]:::staff
    end

    subgraph Daily["Daily"]
        B --> F1["Upcoming / Needs action / All"]:::staff
        F1 --> N{"Needs action?"}:::system
        N -->|"RAYZA refused a paid booking"| N1["Rebook in RAYZA or refund;<br/>contact the guest"]:::warn
        N -->|"RAYZA failed / not sent"| N2["Send to RAYZA again"]:::staff
        B --> T["Guest paid by direct bank transfer"]:::staff
        T --> T1["Record transfer received<br/>→ confirmed, pushed to RAYZA, receipt sent"]:::rayza
        B --> C["Cancel booking<br/>→ released in RAYZA"]:::rayza
        B --> G["Guest cancelled online:<br/>front-desk email with refund due"]:::system
        G --> G1["Issue refund in Paystack dashboard<br/>— not automatic"]:::warn
    end
