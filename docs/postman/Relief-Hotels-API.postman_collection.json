  "item": [
    {
      "name": "RAYZA Connect (SaaS relay)",
      "description": "RAYZA Connect relay API at `{{rayza_base_url}}`. Authenticate with the `authorization` header (API key). OpenAPI: `/openapi.json`, Swagger UI: `/docs`.",
      "item": [
        {
          "name": "Create booking (test mode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "{{rayza_api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{rayza_base_url}}/v1/bookings",
            "description": "Create a test booking (`is_test: true`). A unique `booking_reference` is generated in the pre-request script and saved after a successful 201 response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_reference\": \"{{rayza_booking_reference}}\",\n  \"guest_name\": \"Test Guest\",\n  \"guest_phone\": \"+2348012345678\",\n  \"guest_email\": \"test@example.com\",\n  \"room_identifier\": \"{{rayza_room_identifier}}\",\n  \"check_in\": \"{{check_in}}\",\n  \"check_out\": \"{{check_out}}\",\n  \"amount\": 150000,\n  \"currency\": \"NGN\",\n  \"is_test\": true,\n  \"source_platform\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "const ref = `RH-RAYZA-${ts}`;",
                  "pm.collectionVariables.set('rayza_booking_reference', ref);",
                  "pm.environment.set('rayza_booking_reference', ref);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    let body = {};",
                  "    try { body = pm.response.json(); } catch (e) {}",
                  "    const ref = body.booking_reference || pm.variables.get('rayza_booking_reference');",
                  "    pm.environment.set('rayza_booking_reference', ref);",
                  "    pm.collectionVariables.set('rayza_booking_reference', ref);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create booking (live)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "{{rayza_api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{rayza_base_url}}/v1/bookings",
            "description": "Create a live booking (`is_test: false`). Uses the same reference-chaining scripts as the test-mode request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_reference\": \"{{rayza_booking_reference}}\",\n  \"guest_name\": \"Live Guest\",\n  \"guest_phone\": \"+2348098765432\",\n  \"guest_email\": \"live.guest@example.com\",\n  \"room_identifier\": \"{{rayza_room_identifier}}\",\n  \"check_in\": \"{{check_in}}\",\n  \"check_out\": \"{{check_out}}\",\n  \"amount\": 250000,\n  \"currency\": \"NGN\",\n  \"is_test\": false,\n  \"source_platform\": \"relief-hotels\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "const ref = `RH-RAYZA-${ts}`;",
                  "pm.collectionVariables.set('rayza_booking_reference', ref);",
                  "pm.environment.set('rayza_booking_reference', ref);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    let body = {};",
                  "    try { body = pm.response.json(); } catch (e) {}",
                  "    const ref = body.booking_reference || pm.variables.get('rayza_booking_reference');",
                  "    pm.environment.set('rayza_booking_reference', ref);",
                  "    pm.collectionVariables.set('rayza_booking_reference', ref);",
                  "}"
                ]
              }
            }
          ]
        },
