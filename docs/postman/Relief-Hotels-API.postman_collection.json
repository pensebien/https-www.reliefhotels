        {
          "name": "Guest booking flow",
          "item": [
            {
              "name": "POST /api/reservations",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "url": "{{relief_base_url}}/api/reservations",
                "description": "Create a guest room reservation. On success, saves `reservation_id` for the Paystack flow.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Okonkwo\",\n  \"email\": \"{{guest_email}}\",\n  \"phone\": \"+2348012345678\",\n  \"stayPreference\": \"{{room_id}} \u00b7 2 night(s) \u00b7 2 guest(s)\",\n  \"message\": \"Late arrival after 9pm. Quiet room preferred.\",\n  \"itemType\": \"room\",\n  \"roomId\": \"{{room_id}}\",\n  \"checkIn\": \"{{check_in}}\",\n  \"checkOut\": \"{{check_out}}\",\n  \"nights\": 2,\n  \"guests\": 2\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                      "const json = pm.response.json();",
                      "pm.test('Reservation id returned', function () { pm.expect(json.id).to.be.a('string'); });",
                      "if (json.id) {",
                      "    pm.environment.set('reservation_id', json.id);",
                      "    pm.collectionVariables.set('reservation_id', json.id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "POST /api/paystack/initialize",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "url": "{{relief_base_url}}/api/paystack/initialize",
                "description": "Initialize a Paystack deposit payment. Requires `reservation_id` from the prior reservation step. Saves `payment_reference` on success.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{guest_email}}\",\n  \"itemType\": \"room\",\n  \"itemId\": \"{{room_id}}\",\n  \"reservationId\": \"{{reservation_id}}\",\n  \"nights\": 2,\n  \"demoAmountNgn\": 5000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                      "const json = pm.response.json();",
                      "pm.test('Payment reference returned', function () { pm.expect(json.reference).to.be.a('string'); });",
                      "if (json.reference) {",
                      "    pm.environment.set('payment_reference', json.reference);",
                      "    pm.collectionVariables.set('payment_reference', json.reference);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "GET /api/paystack/verify",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{relief_base_url}}/api/paystack/verify?reference={{payment_reference}}&demo=1",
                  "host": [
                    "{{relief_base_url}}"
                  ],
                  "path": [
                    "api",
                    "paystack",
                    "verify"
                  ],
                  "query": [
                    {
                      "key": "reference",
                      "value": "{{payment_reference}}"
                    },
                    {
                      "key": "demo",
                      "value": "1"
                    }
                  ]
                },
                "description": "Verify a Paystack payment by reference. Use `demo=1` for simulated success without live Paystack keys."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                    ]
                  }
                }
              ]
            }
          ]
        },
