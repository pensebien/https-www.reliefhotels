    {
      "name": "Relief Hotels API",
      "description": "Relief Hotels website API at `{{relief_base_url}}`. Guest endpoints are public; staff/HMS endpoints require `?key={{dashboard_key}}`.",
      "item": [
        {
          "name": "Health & config",
          "item": [
            {
              "name": "GET /api/health",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{relief_base_url}}/api/health",
                "description": "Public health check. Verifies storage readiness and whether `productionReady` is true (Supabase connected)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                      "const json = pm.response.json();",
                      "pm.test('Response has productionReady boolean', function () {",
                      "    pm.expect(json).to.have.property('productionReady');",
                      "    pm.expect(json.productionReady).to.be.a('boolean');",
                      "});",
                      "pm.test('Response ok is true', function () { pm.expect(json.ok).to.eql(true); });"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
