# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# cursor (local IDE config — do not commit)
.cursor/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# live demo submissions (local only)
/data/demo-store.json
/data/inquiries.json

# bvdlc local scaffolding script
/bvdlc.sh

# git worktrees (keep agent-workspaces/README.md tracked)
/agent-workspaces/*
!/agent-workspaces/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
